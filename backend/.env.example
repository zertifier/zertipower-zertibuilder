# ===================================================
# Zertipower Backend - plantilla de configuracion
# ===================================================
# Copia este archivo a `.env` y rellena los valores reales.
#   cp .env.example .env
#
# NUNCA subas el archivo `.env` al repositorio: contiene
# credenciales de produccion, claves de Stripe y una clave
# privada de blockchain (PK).
#
# Todas las variables marcadas como requeridas se validan al
# arrancar en:
#   src/shared/infrastructure/services/environment-service/env-schema.json
# Si falta una sola, el backend aborta el arranque.
# ===================================================

# --- BASE DE DATOS (MariaDB local via Docker) -------------------------
# Con docker-compose.db.yml los valores por defecto son root/root.
DATABASE_URL="mysql://root:root@127.0.0.1:3306/zertipower-dev"
DB_HOST="127.0.0.1"
DB_USER="root"
DB_PASSWORD="root"
DB_DATABASE="zertipower-dev"

# --- SERVIDOR ---------------------------------------------------------
PORT=3000
# Secreto de firma de los JWT. Usa una cadena larga y aleatoria.
JWT_SECRET="<cadena-aleatoria-larga>"
APPLICATION_NAME="API"
VIEWS_FOLDER="src/shared/infrastructure/views/public"

# --- URLs DE LOS FRONTENDS -------------------------------------------
# Se usan para redirecciones (p.ej. OAuth y recuperacion de password).
# NO controlan CORS: main.ts arranca Nest con `cors: true` (permisivo).
FRONTEND_URL="http://localhost:4201"        # Panel Admin
COMPTADOR_FRONTEND_URL="http://localhost:4200"  # Contador / Smart Meter
# La Calculadora (4202) no tiene variable propia y no la necesita.

# --- GOOGLE OAUTH -----------------------------------------------------
GOOGLE_CLIENT_ID="<google-client-id>"
GOOGLE_CLIENT_SECRET="<google-client-secret>"

# --- SERVICIOS EXTERNOS ----------------------------------------------
RADIATION_API="https://apiv2.wattabit.com"
# Formato obligatorio: <usuario>:<password>
RADIATION_API_CREDENTIALS="<usuario>:<password>"
ENERGY_PREDICTION_API="https://prediction.zertipower.com"
DATADIS_MONTHS=1
TRADE_UPDATE_DAYS=30

# --- API METEOROLÓGICA (Open Meteo) -----------------------------------
# Open Meteo es gratuito y no requiere API key para uso no comercial
# Límites: 10,000 llamadas/día, 5,000/hora, 600/minuto
# Para uso comercial: https://open-meteo.com/en/pricing
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
# OPEN_METEO_API_KEY="<api-key>"  # Solo necesario para uso comercial

# --- CONFIGURACIÓN SOLAR PARA PREDICCIÓN -------------------------------
# JSON con configuración específica por CUPS ID para predicción solar
# Formato: {"<cups_id>": {"latitud": 42.18, "longitud": 2.48, "kwp": 7.22, "potencia_inversor_kw": 6, "graus": 30, "performance_ratio": 0.8, "orientacio": "sud-oest", "azimut": 225}}
SOLAR_INSTALLATIONS_JSON="{}"
# Credenciales para API de predicción solar (si se usa alternativa a Open Meteo)
SOLAR_API_URL="https://ai.megatro.cat:9999/previsio"
SOLAR_API_AUTH_CODE="<auth-code>"
SOLAR_API_ALLOW_INSECURE_TLS="false"

# --- CONFIGURACIÓN COMUNIDAD MONTOLIVET -------------------------------
# ID de la comunidad Montolivet en la base de datos
MONTOLIVET_COMMUNITY_ID="1"

# --- BLOCKCHAIN -------------------------------------------------------
# Clave privada usada para firmar transacciones on-chain.
# SECRETO CRITICO: si se filtra, se compromete la wallet asociada.
PK="<clave-privada-hex-64-caracteres>"

# --- STRIPE -----------------------------------------------------------
STRIPE_PRODUCT_ID="<prod_...>"
STRIPE_PRICE_KEY="<price_...>"
STRIPE_SECRET_KEY="<sk_test_...>"

# --- SMTP -------------------------------------------------------------
# En local puede dejarse con valores ficticios: el arranque no falla,
# solo fallara el envio real de correo.
SMTP_USER="no-reply@example.com"
SMTP_DISPLAY_EMAIL="no-reply@example.com"
SMTP_PASSWORD="example_password"
SMTP_SERVER="smtp.example.com"
SMTP_PORT=465

# Explicit CUPS ID -> energy_areas ID mapping; leave empty until confirmed.
SOLAR_CUPS_AREAS_JSON={}

# Disabled by default. Temporary equal-surface community simulation.
SOLAR_TEST_HOUSE_M2=0
SOLAR_TEST_COMMUNITY_ID=0

# Optional local historical consumption estimate; disabled by default.
CONSUMPTION_LOCAL_TEST_COMMUNITY_ID=0
